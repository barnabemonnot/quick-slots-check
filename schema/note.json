{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema/note.json",
  "title": "Front matter of a compatibility note",
  "description": "One note describes one instance of a class: a named system, bound to a pinned block or release. Evidence labels: CHECKED, INFERRED, UNVERIFIED.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "id",
    "layer",
    "class",
    "cause",
    "effect",
    "impact",
    "priority",
    "at_10s",
    "fix",
    "common_wrong_fix",
    "who_acts",
    "timing",
    "status",
    "evidence",
    "reproduction"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "description": "System and effect, e.g. 'Example LST oracle: report window closes at 10 s'."
    },
    "id": {
      "type": "string",
      "pattern": "^(ON[1-8]|OFF[1-7]|R([1-9]|1[0-7]))-[0-9]{3,}$",
      "description": "Class ID plus a running number, e.g. ON1-001."
    },
    "layer": {
      "enum": [
        "onchain",
        "offchain",
        "spec"
      ]
    },
    "chain": {
      "type": "string",
      "description": "mainnet, n/a, or the chain name."
    },
    "addresses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Proxy and implementation, at the pinned block named in the Evidence section."
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "org/repo@commit path:lines."
    },
    "class": {
      "type": "string",
      "pattern": "^(ON[1-8]|OFF[1-7]|R([1-9]|1[0-7]))$"
    },
    "cause": {
      "enum": [
        "S1",
        "S2",
        "S3",
        "S4",
        "S5",
        "S6",
        "S1+S4",
        "S1+S5",
        "S1/S2",
        "S1/S5",
        "S1/S6"
      ]
    },
    "effect": {
      "enum": [
        "BREAKS",
        "DRIFTS",
        "BENIGN"
      ]
    },
    "impact": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "NONE"
      ]
    },
    "priority": {
      "enum": [
        "P1",
        "P2",
        "P3"
      ]
    },
    "at_10s": {
      "type": "string",
      "minLength": 3,
      "description": "What changes after a fork to 10 s, and when."
    },
    "at_8s": {
      "type": "string",
      "description": "Same at 8 s if the kind changes, else 'same kind'."
    },
    "affected_function": {
      "type": "string"
    },
    "fix": {
      "type": "string",
      "minLength": 3
    },
    "common_wrong_fix": {
      "type": "string",
      "minLength": 3,
      "description": "A wrong fix that looks correct, or 'none known'."
    },
    "fix_layer": {
      "enum": [
        "offchain release",
        "offchain config",
        "onchain config",
        "contract upgrade",
        "redeploy / migration",
        "governance"
      ]
    },
    "upgradeable": {
      "type": "string"
    },
    "who_acts": {
      "type": "string",
      "description": "The team or role that would make the change."
    },
    "lead_time": {
      "type": "string"
    },
    "timing": {
      "type": "string",
      "description": "Before the fork, at the fork, or within a time after it."
    },
    "depends_on_spec": {
      "type": "string",
      "pattern": "^(none|R([1-9]|1[0-7])(, ?R([1-9]|1[0-7]))*)$"
    },
    "lenses": {
      "type": "string",
      "description": "Number of independent checks and their model families or humans."
    },
    "status": {
      "enum": [
        "open",
        "reproduced",
        "disputed",
        "fixed"
      ]
    },
    "evidence": {
      "enum": [
        "CHECKED",
        "INFERRED",
        "UNVERIFIED"
      ]
    },
    "reproduction": {
      "type": "string",
      "description": "A path in this repository (vectors/, tests/) or 'none'."
    },
    "impact_axes": {
      "type": "string",
      "pattern": "^I[0-4] T[0-3] R[0-3] recovery=(none|governance|owner|operator|user)$",
      "description": "RATING.md section 2. Required for MEDIUM and HIGH."
    },
    "reach_measure": {
      "type": "string",
      "description": "Value per 30 days or held, the block, and the query. Required for MEDIUM and HIGH."
    },
    "triage": {
      "type": "string",
      "description": "<model family or human>, blind, <date>, <level>."
    }
  }
}
